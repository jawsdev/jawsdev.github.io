---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="text-center mb-12">
            <h2 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-brand-primary mb-6">
                Welcome to my development blog.
            </h2>
            <p class="text-xl text-brand-primary max-w-3xl mx-auto leading-relaxed">
                Hey there! This is where I write about coding experiments in my
                <a href="/blog" class="text-brand-accent-dark font-semibold hover:underline">blog</a>, showcase what I'm building in my
                <a href="/projects" class="text-brand-accent-dark font-semibold hover:underline">projects</a>, and maybe share some
                retro tech adventures and music too.
                Just sharing what I'm building and learning along the way. Want to know more
                <a href="/about" class="text-brand-accent-dark font-semibold hover:underline">about me</a>?
            </p>
        </div>

        <div class="grid gap-8 md:gap-12">
            <div class="bg-white rounded-lg shadow-md p-6 sm:p-8">
                <h2 class="text-2xl font-semibold text-gray-900 mb-4">Getting Started</h2>
                <p class="text-gray-700 mb-4 leading-relaxed">

                </p>
            </div>

        </div>
	</div>
</BaseLayout>
