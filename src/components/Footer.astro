---
const today = new Date();
---

<footer class="bg-brand-primary text-white py-12">
	<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col md:flex-row justify-between items-center">
			<div class="mb-6 md:mb-0">
				<p class="text-sm">
					&copy; {today.getFullYear()} John Weeks. All rights reserved.
				</p>
				<p class="text-xs text-gray-400 mt-1">
					Built using <a href="https://astro.build" class="text-brand-accent hover:text-accent-light transition-colors">Astro</a> and <a href="https://tailwindcss.com" class="text-brand-accent hover:text-accent-light transition-colors">Tailwind CSS</a>
				</p>
			</div>

			<div class="flex items-center space-x-6">
				<span class="text-sm text-gray-400">Follow me:</span>
				<div class="flex space-x-4">
					<a href="https://github.com/withastro/astro" target="_blank" class="text-gray-400 hover:text-brand-accent-light transition-colors duration-200" aria-label="Go to Astro's GitHub repo">
						<span class="sr-only">Go to Astro's GitHub repo</span>
						<svg class="w-6 h-6" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
