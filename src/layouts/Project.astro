---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Prose from '../components/Prose.astro';

type Props = CollectionEntry<'projects'>['data'] & { projectId: string };

const { title, description, startDate, updatedDate, heroImage, status, technologies, projectId } = Astro.props;

// Get all blog posts related to this project
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
	.filter(post => post.data.project === projectId)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const statusColors = {
	'planning': 'bg-yellow-100 text-yellow-800 border-yellow-200',
	'in-progress': 'bg-blue-100 text-blue-800 border-blue-200',
	'completed': 'bg-green-100 text-green-800 border-green-200',
	'on-hold': 'bg-gray-100 text-gray-800 border-gray-200'
};
---

<BaseLayout title={title} description={description}>
	<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
			<article class="bg-white rounded-lg shadow-lg overflow-hidden">
				{heroImage && (
					<div class="w-full h-64 sm:h-80 lg:h-96 overflow-hidden">
						<Image
							width={1020}
							height={510}
							src={heroImage}
							alt=""
							class="w-full h-full object-cover"
						/>
					</div>
				)}

				<div class="px-6 sm:px-8 lg:px-12 py-8">
					<header class="mb-8 text-center border-b border-gray-200 pb-8">
						<div class="mb-4 flex items-center justify-center space-x-4">
							<time class="text-sm text-gray-500 font-medium">
								Started <FormattedDate date={startDate} />
							</time>
							<span class={`px-3 py-1 text-sm font-semibold rounded-full border ${statusColors[status]}`}>
								{status.replace('-', ' ')}
							</span>
						</div>
						{updatedDate && (
							<div class="text-sm text-gray-400 italic mb-4">
								Last updated on <FormattedDate date={updatedDate} />
							</div>
						)}
						<h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 leading-tight mb-4">
							{title}
						</h1>
						{description && (
							<p class="text-lg text-gray-600 max-w-3xl mx-auto leading-relaxed mb-6">
								{description}
							</p>
						)}
						{technologies && technologies.length > 0 && (
							<div class="flex flex-wrap space-x-4 justify-center">
								{technologies.map((tech) => (
									<span class="px-3 py-1 text-sm bg-brand-primary text-white rounded-md">
										{tech}
									</span>
								))}
							</div>
						)}
					</header>

					<Prose>
						<slot />
					</Prose>

					{relatedPosts.length > 0 && (
						<div class="mt-12 pt-8 border-t border-gray-200">
							<h2 class="text-2xl font-bold text-gray-900 mb-6">Project Posts</h2>
							<div class="space-y-4">
								{relatedPosts.map((post) => (
									<div class="bg-white border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
										<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
											<div class="flex-1">
												<h3 class="text-lg font-semibold text-gray-900 mb-2">
													{post.data.title}
												</h3>
												{post.data.description && (
													<p class="text-gray-600 text-sm leading-relaxed mb-3">
														{post.data.description}
													</p>
												)}
												<time class="text-sm text-gray-500">
													<FormattedDate date={post.data.pubDate} />
												</time>
											</div>
											<div class="flex-shrink-0">
												<a
													href={`/blog/${post.id}/`}
													class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-brand-primary hover:bg-brand-primary/90 rounded-md transition-colors"
												>
													View Post
												</a>
											</div>
										</div>
									</div>
								))}
							</div>
						</div>
					)}
				</div>
			</article>
	</div>

</BaseLayout>